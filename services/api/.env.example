# Copy to .env locally; never paste real values into chat or commit them.
# Runtime must be facetrack_api (non-owner, NOBYPASSRLS). Migration credentials are separate.
DATABASE_URL=postgresql+psycopg://facetrack_api:REPLACE@HOST:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:REPLACE@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PROJECT_KEY
# Server-only Storage access. Leave blank until `tools.configure_biometrics`.
SUPABASE_STORAGE_SECRET=
# Private bucket names may be changed before provisioning, but must then stay stable.
ENROLLMENT_BUCKET=facetrack-enrollment-dev
DOCUMENTS_BUCKET=facetrack-documents-dev
# 32 random bytes as 64 hex digits; keep prior keys until corresponding codes expire.
JOIN_CODE_KEYS={"v1":"REPLACE_WITH_64_HEX_DIGITS"}
JOIN_CODE_KEY_ID=v1
# Generated by `tools.configure_biometrics`; never copy these values to Flutter.
TEMPLATE_KEYS={}
TEMPLATE_KEY_ID=v1
CORS_ORIGINS=["http://localhost:5300","http://localhost:5301"]
ENVIRONMENT=development
# Optional faculty report email. Downloads work when these remain blank.
RESEND_API_KEY=
RESEND_FROM=
FACULTY_REPORT_URL=http://localhost:5300
# Optional: lets admins create login accounts from the Admin tab. Server only.
SUPABASE_SERVICE_ROLE_KEY=
